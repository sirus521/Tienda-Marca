# ============================================================================
# Configuración de npm registry
# ----------------------------------------------------------------------------
# OJO: pnpm 11 SOLO lee `.npmrc` para autenticación y registry. Cualquier otro
# ajuste (red, resolución, scripts de build) se ignora aquí y debe ir en
# `pnpm-workspace.yaml`. Este archivo se mantiene deliberadamente mínimo.
# ============================================================================

registry=https://registry.npmjs.org/