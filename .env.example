# ============================================================================
# Variables de entorno — plantilla
# Copiar a `.env.local` para desarrollo. NUNCA subir `.env.local` al repo.
# ============================================================================

# URL canónica del sitio. Se usa en Open Graph, sitemap y enlaces absolutos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# FASE 4 — Cloudflare D1 (base de datos)
# Se activa al crear el proyecto en Cloudflare con `wrangler d1 create`.
# Los bindings se declaran en `wrangler.jsonc`, no aquí.
# ----------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=

# ----------------------------------------------------------------------------
# FASE 5 — Autenticación del admin
# Generar con: openssl rand -base64 32
# Sin este secreto no se pueden firmar las sesiones del panel.
# ----------------------------------------------------------------------------
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# FASE 7 — Cloudflare R2 (imágenes de producto)
# Estas credenciales NUNCA se exponen al navegador: solo se usan en el
# servidor para firmar URLs temporales de subida.
# ----------------------------------------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ac-product-images
# R2_PUBLIC_URL=https://img.ejemplo.com

# ----------------------------------------------------------------------------
# Checkout — SOLO si `checkoutMode` cambia a "mercadopago" en config/brand.ts
# ----------------------------------------------------------------------------
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=